<?xml version="1.0" encoding="UTF-8" ?>
<profiles xmlns="http://www.eprosima.com">
  <!-- 1) Define the SHM transport -->
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>shm_transport</transport_id>
      <type>SHM</type>
      <!-- tune as needed: max message size + header -->
      <segment_size>524288</segment_size>
      <port_queue_capacity>1024</port_queue_capacity>
    </transport_descriptor>
  </transport_descriptors>

  <!-- 2) Reference it in your participant -->
  <participant profile_name="disable_multicast" is_default_profile="true">
    <rtps>
      <!-- 3) If you want ONLY SHM, turn off built-ins -->
      <useBuiltinTransports>false</useBuiltinTransports>
      <userTransports>
        <transport_id>shm_transport</transport_id>
      </userTransports>
    </rtps>
  </participant>
</profiles>
